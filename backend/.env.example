# Server Environment
PORT=5000
NODE_ENV=development

# MySQL Relational Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=stitchgrid
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# JWT Authentication Secrets (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend Client Origin
CLIENT_URL=https://it-support-desk-puce.vercel.app
# MongoDB (Audit & Activity Logging)
MONGO_URI=mongodb://127.0.0.1:27017/stitchgrid_activity
